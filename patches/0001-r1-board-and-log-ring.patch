diff --git a/kernel/kernel-6.6/arch/mips/xburst/Kconfig b/kernel/kernel-6.6/arch/mips/xburst/Kconfig
index 8d5487393..de2d3eb35 100644
--- a/kernel/kernel-6.6/arch/mips/xburst/Kconfig
+++ b/kernel/kernel-6.6/arch/mips/xburst/Kconfig
@@ -75,4 +75,13 @@ config XBURST_MXUV2
 	bool
 	default n
 
+config R1_LOG_RING
+	bool "Early console into a RAM log ring (HiBy R1 dev loop)"
+	depends on SOC_X1600 && EARLY_PRINTK
+
+config R1_LOG_RING_PHYS
+	hex "Log ring physical address"
+	depends on R1_LOG_RING
+	default 0x03f00000
+
 endif
diff --git a/kernel/kernel-6.6/arch/mips/xburst/soc-x1600/Kconfig.DT b/kernel/kernel-6.6/arch/mips/xburst/soc-x1600/Kconfig.DT
