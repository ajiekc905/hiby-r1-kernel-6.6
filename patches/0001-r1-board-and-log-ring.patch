+++ b/kernel/kernel-6.6/arch/mips/xburst/soc-x1600/Kconfig.DT
@@ -17,6 +17,9 @@ config DT_HALLEY6_V20
 config DT_HALLEY6_V20_SEEKWAVE
 	bool "x1600 halley6 v20 seekwave wifi&bt"
 
+config DT_HIBY_R1
+	bool "HiBy R1"
+
 endchoice
 
 config DT_X1600_MODULE_BASE_DTS_FILE
diff --git a/kernel/kernel-6.6/arch/mips/xburst/soc-x1600/Makefile b/kernel/kernel-6.6/arch/mips/xburst/soc-x1600/Makefile
index e6d651896..6be787c98 100644
