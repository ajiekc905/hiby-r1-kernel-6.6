@@ -2,6 +2,10 @@ obj-y += setup.o
 obj-y += regs_save_restore.o
 obj-y += gpio.o
 obj-y += reset.o
+ifdef CONFIG_R1_LOG_RING
+obj-y += r1ring.o
+else
