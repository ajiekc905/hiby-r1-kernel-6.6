+++ b/kernel/kernel-6.6/drivers/usb/gadget/function/Makefile
@@ -40,6 +40,8 @@ usb_f_uac1_legacy-y		:= f_uac1_legacy.o u_uac1_legacy.o
 obj-$(CONFIG_USB_F_UAC1_LEGACY)	+= usb_f_uac1_legacy.o
 usb_f_uac2-y			:= f_uac2.o
 obj-$(CONFIG_USB_F_UAC2)	+= usb_f_uac2.o
+usb_f_uac_sa-y			:= f_uac_sa.o
+obj-$(CONFIG_USB_F_UAC_SA)	+= usb_f_uac_sa.o
 usb_f_uvc-y			:= f_uvc.o uvc_queue.o uvc_v4l2.o uvc_video.o uvc_configfs.o
 obj-$(CONFIG_USB_F_UVC)		+= usb_f_uvc.o
 usb_f_midi-y			:= f_midi.o
