@@ -381,6 +381,28 @@ static ssize_t sw_switch_hsotg_store(struct device *dev, struct device_attribute
 	return count;
 }
 
+static struct usb_phy_data *ingenic_phy_single;
+
+void ingenic_usb_phy_id_host(int host)
+{
+	struct usb_phy_data *usb_phy = ingenic_phy_single;
+	unsigned int usbrdt;
+	unsigned long flags;
+
+	if (!usb_phy)
+		return;
+	spin_lock_irqsave(&usb_phy->sw_switch_id_lock, flags);
+	usbrdt = cpm_inl(CPM_USBRDT);
+	usbrdt |= USBRDT_IDDIG_EN;
+	if (host)
+		usbrdt &= ~USBRDT_IDDIG_REG;
+	else
+		usbrdt |= USBRDT_IDDIG_REG;
+	cpm_outl(usbrdt, CPM_USBRDT);
+	spin_unlock_irqrestore(&usb_phy->sw_switch_id_lock, flags);
+}
+EXPORT_SYMBOL_GPL(ingenic_usb_phy_id_host);
+
 static DEVICE_ATTR(sw_switch_hsotg, S_IWUSR, NULL, sw_switch_hsotg_store);
 
