@@ -15,4 +15,14 @@ config MTD_BLOCK_BBT_RO_BLOCK_SIZE
 	depends on MTD_BLOCK_BBT_RO
 	default 4096
 
+config R1_SFC_READONLY
+	bool "Ingenic SFC NAND: writes only in the userdata partition"
+	help
+	  The driver's page program and block erase return -EROFS outside
+	  the burner partition named "userdata" (found at probe, end
+	  clamped to the MTD size), and every other partition loses
+	  MTD_WRITEABLE, so only userdata can be written (HiBy R1: the
+	  stock rootfs, kernel and recovery stay read-only, /usr/data
+	  settings, Wi-Fi and Bluetooth state can be saved).
+
 endif # MTD
