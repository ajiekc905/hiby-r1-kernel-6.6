 	struct ingenic_sfcnand_ops *ops = nand_info->ops;
 	struct sfc_cdt_xfer xfer;
 	int32_t ret = 0;
+#ifdef CONFIG_R1_SFC_READONLY
+	if (!r1_userdata_range(flash,
+			(loff_t)flash_address->pageaddr * flash->mtd.writesize +
+			flash_address->columnaddr, len))
+		return -EROFS;
+#endif
 
 	memset(&xfer, 0, sizeof(xfer));
 
