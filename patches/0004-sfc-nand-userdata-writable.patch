 	return ret;
 }
 
+#ifdef CONFIG_R1_SFC_READONLY
+static bool r1_userdata_range(struct sfc_flash *flash, loff_t addr, size_t len)
+{
+	struct ingenic_sfcnand_flashinfo *nand_info = flash->flash_info;
+	struct mtd_partition *part = nand_info->partition.partition;
+	uint8_t num = nand_info->partition.num_partition;
+	uint8_t i;
+
+	if (!part || !len)
+		return false;
+	for (i = 0; i < num; i++) {
+		loff_t end;
+
+		if (strcmp(part[i].name, "userdata"))
+			continue;
+		end = part[i].offset + part[i].size;
+		if (end > flash->mtd.size)
+			end = flash->mtd.size;
+		return addr >= (loff_t)part[i].offset &&
+		       addr + (loff_t)len <= end;
+	}
+	return false;
+}
+#endif
+
 static int32_t sfcnand_do_write(struct sfc_flash *flash, u_char *buffer, struct flash_address *flash_address, size_t len)
