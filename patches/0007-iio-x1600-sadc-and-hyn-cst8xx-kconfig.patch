diff --git a/kernel/kernel-6.6/drivers/iio/adc/Kconfig b/kernel/kernel-6.6/drivers/iio/adc/Kconfig
index 517b3db11..cf5ddfeca 100644
--- a/kernel/kernel-6.6/drivers/iio/adc/Kconfig
+++ b/kernel/kernel-6.6/drivers/iio/adc/Kconfig
@@ -525,6 +525,12 @@ config INA2XX_ADC
 	  Say yes here to build support for TI INA2xx family of Power Monitors.
 	  This driver is mutually exclusive with the HWMON version.
 
+config X1600_SADC
+	tristate "Ingenic X1600 SADC auxiliary channels"
+	depends on MACH_XBURST || COMPILE_TEST
+	help
+	  The four AUX channels of the Ingenic X1600 SADC as IIO voltages.
+
 config INGENIC_ADC
 	tristate "Ingenic JZ47xx SoCs ADC driver"
 	depends on MIPS || COMPILE_TEST
